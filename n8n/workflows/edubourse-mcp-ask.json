      "parameters": {
        "jsCode": "const body = $json.body ?? $json;\nconst message = body.message;\nconst threadId = body.thread_id;\nconst validMessage = typeof message === 'string' && message.trim().length >= 1 && message.length <= 4000;\nconst validThread = typeof threadId === 'string' && threadId.trim().length >= 1 && threadId.length <= 200 && !/[\\u0000\\r\\n]/.test(threadId);\nif (!validMessage || !validThread) {\n  return [{ json: { status: 'error', error: 'invalid_request' } }];\n}\nreturn [{ json: { message, thread_id: threadId } }];"
      },
