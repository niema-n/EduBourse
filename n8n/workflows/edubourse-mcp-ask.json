    {
      "parameters": {
        "jsCode": "const rpc = $json;\nif (rpc.error || !rpc.result) {\n  return [{ json: { status: 'error', error: 'mcp_unavailable' } }];\n}\nconst structured = rpc.result.structuredContent;\nlet payload = structured;\nif (!payload && Array.isArray(rpc.result.content)) {\n  const text = rpc.result.content.find((item) => item.type === 'text')?.text;\n  try { payload = text ? JSON.parse(text) : null; } catch { payload = null; }\n}\nif (!payload || typeof payload !== 'object') {\n  return [{ json: { status: 'error', error: 'invalid_backend_response' } }];\n}\nconst fields = ['status', 'answer', 'language', 'script', 'route', 'blocked', 'thread_id', 'grounded', 'citations'];\nconst result = Object.fromEntries(fields.filter((field) => field in payload).map((field) => [field, payload[field]]));\nif (typeof result.status !== 'string' || typeof result.answer !== 'string') {\n  return [{ json: { status: 'error', error: 'invalid_backend_response' } }];\n}\nreturn [{ json: result }];"
      },
